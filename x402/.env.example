# verified-random x402 config
OPENRNG_TREASURY=0xYOUR_BASE_WALLET_ADDRESS

# Facilitator: use x402.org/facilitator for testing, CDP facilitator for production
# For production: npm install @coinbase/x402, configure CDP_API_KEY_ID + CDP_API_KEY_SECRET
X402_FACILITATOR=https://x402.org/facilitator

# Network: eip155:84532 = Base Sepolia (testnet), eip155:8453 = Base mainnet
# MUST match the facilitator — testnet facilitator + mainnet network = broken
X402_NETWORK=eip155:84532

UPSTREAM_API=http://localhost:3000
X402_PORT=8402
ANCHOR_CHAIN=polygon-amoy
MERKLE_ANCHOR_CONTRACT=0xA79E149C35Ad47Ed270Bf4b16B80170eBF7B88F8
RATE_LIMIT_PER_WALLET=50
FAILED_PAYMENTS_LOG=/var/log/verified-random-canceled-payments.jsonl
